{
  "theme": "base",
  "securityLevel": "strict",
  "htmlLabels": false,
  "deterministicIds": true,
  "fontFamily": "Segoe UI",
  "themeCSS": ".edgeLabel .background { fill: #ffffff !important; opacity: 1 !important; }",
  "themeVariables": {
    "fontFamily": "Segoe UI",
    "fontSize": "18px",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#242424",
    "primaryBorderColor": "#b11f4b",
    "lineColor": "#5c5c5c",
    "secondaryColor": "#f7f4ef",
    "tertiaryColor": "#fcfbf8",
    "clusterBkg": "#f7f4ef",
    "clusterBorder": "#dedede",
    "edgeLabelBackground": "#ffffff"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "stepAfter",
    "nodeSpacing": 28,
    "rankSpacing": 50,
    "padding": 16,
    "useMaxWidth": true
  }
}
